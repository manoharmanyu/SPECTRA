# =================================================================
# SPECTRA Forensic Backend — Environment Configuration Template
# =================================================================

# Server Core
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
SPECTRA_API_BASE_URL=http://localhost:8000

# Security Tokens (Generate strong random secrets in production)
# Used for internal n8n <-> backend stage execution verification
SPECTRA_INTERNAL_TOKEN=spectra_internal_dev_secret_token_change_in_production
# Header sent when dispatching jobs to n8n webhook (X-SPECTRA-WEBHOOK-TOKEN)
SPECTRA_WEBHOOK_TOKEN=spectra_webhook_dev_token_change_in_production

# Database (PostgreSQL recommended; SQLite supported for local development)
DATABASE_URL=sqlite:///./spectra_forensics.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spectra_forensics

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://thespectra.vercel.app,https://spectra-mobile.vercel.app

# Storage Configuration
# Options: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage_data
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB
UPLOAD_RETENTION_DAYS=7

# S3 Compatible Object Storage (Optional, used if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=us-east-1

# n8n Workflow Automation (Optional)
# If left empty, backend runs stages in standalone background task mode
N8N_WEBHOOK_URL=http://localhost:5678/webhook/spectra-analysis
STANDALONE_PIPELINE=true

# Forensic Detection Providers (Optional)
# Hive AI Detector API: https://thehive.ai/
HIVE_API_KEY=
# Google Gemini API (Optional, for explanatory contextual summary only)
GEMINI_API_KEY=
